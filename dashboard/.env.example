# ---------------------------------------------------------------------------
# L2 Arbitrage GUI — environment configuration
# Copy to `.env` and adjust. Everything has safe defaults; the app runs with
# ZERO configuration in simulation mode.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# Port the API + WebSocket server listens on.
PORT=8787
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173

# Data source for arbitrage opportunities:
#   simulated -> built-in engine, no external calls, works out of the box
#   external  -> real detections from the Rust ingestion layer over WebSocket
#                (the wired production path; see INGEST_FEED_URL below)
#   live      -> poll real DEX price feeds over the configured RPCs (needs RPC URLs)
DATA_SOURCE=simulated

# WebSocket URL of the ingestion layer's output sink. Used when DATA_SOURCE=external.
INGEST_FEED_URL=ws://127.0.0.1:9001

# Execution mode:
#   paper -> simulate fills, never broadcast a transaction (safe default)
#   live  -> build & broadcast real flash-loan transactions (advanced, funds at risk)
EXECUTION_MODE=paper

# Serve the built frontend (frontend/dist) on the same origin as the API
# (single-port desktop / .exe mode). The launcher sets this automatically.
# SERVE_STATIC_DIR=/abs/path/to/frontend/dist

# --- Live data / RPC (only used when DATA_SOURCE=live) ----------------------
# Get free/paid endpoints from Alchemy, Infura, QuickNode, or a public RPC.
# These also enable the read-only execution-readiness latency probe
# (GET /api/health/execution) even in paper mode — it only reads chain state.
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=

# --- Execution-latency probe (read-only; optional) --------------------------
# The probe times eth_blockNumber / eth_gasPrice on the chain below (or the
# first configured RPC). It NEVER broadcasts a transaction. If you supply a
# deployed FlashLoanArbitrage address it additionally staticCalls the cheap
# aavePremiumBps() view (still read-only). Leave unset in paper mode.
# FLASH_LOAN_EXECUTOR_ADDRESS=
# EXECUTION_PROBE_CHAIN=arbitrum

# --- Frontend --------------------------------------------------------------
# Base URL the frontend uses to reach the backend REST + WS API.
VITE_API_URL=http://localhost:8787
# Optional WalletConnect project id (MetaMask via injected connector needs none).
VITE_WALLETCONNECT_PROJECT_ID=
