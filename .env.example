# ═════════════════════════════════════════════════════════════════════════════
# L2 Arbitrage Flash-Loan Bot — THE MASTER .env  (single source of truth)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` at the repo root and edit it. This ONE file configures
# every component — the dashboard, the engine, the contracts deploy tooling, and
# the launcher all read it automatically. You should not need a per-component
# `.env` anymore; each component's `.env.example` is now just a pointer here.
#
# Precedence (highest wins):
#   1. real environment variables (what the launcher injects, or your shell)
#   2. a component-local `.env` (e.g. engine/.env) — optional, for standalone work
#   3. THIS master `.env` at the repo root
#   4. built-in safe defaults
#
# Every value here has a safe default; nothing in the runtime stack is a secret
# (it holds no private keys). The one deploy-only secret — the contracts
# PRIVATE_KEY — is fenced off at the bottom and is NOT read by the running bot.
# `.env` is git-ignored; only this `.env.example` is tracked. Never commit `.env`.
# ═════════════════════════════════════════════════════════════════════════════


# ── Dashboard — Node backend + React UI ──────────────────────────────────────
PORT=8787
# simulated = zero-config paper stream · external = real detections from the
# ingestion layer over WebSocket · live = dashboard's own on-chain quoting (WIP)
DATA_SOURCE=simulated
# Where the dashboard reads real detections when DATA_SOURCE=external:
INGEST_FEED_URL=ws://127.0.0.1:9001
# paper = simulate fills (safe default) · live = gated real execution (disabled)
EXECUTION_MODE=paper
# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173
# Set by the launcher to serve the built UI on the same origin as the API.
# SERVE_STATIC_DIR=/abs/path/to/dashboard/frontend/dist

# Optional RPCs for the dashboard's own (WIP) live provider — not needed for the
# external feed, which gets its data from the ingestion layer. Setting any of
# these also enables the read-only execution-readiness latency probe
# (GET /api/health/execution), which only reads chain state and never broadcasts.
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=
# RPC_URL_UNICHAIN=
# RPC_URL_INK=
# Optional: a deployed FlashLoanArbitrage address to add a read-only staticCall
# (aavePremiumBps) to the execution-latency probe, and the chain to probe.
# FLASH_LOAN_EXECUTOR_ADDRESS=
# EXECUTION_PROBE_CHAIN=arbitrum

# Per-network deployed contract addresses. These are written automatically by the
# dashboard Contracts panel when you deploy a contract from it (the deploy is
# signed in your MetaMask; only the resulting PUBLIC address is recorded here —
# never a key). They also mirror contracts/deployments/<network>.json. The
# Contracts monitor reads them to show which chains are wired, and
# scripts/contract_stress_test.mjs uses them for its read-only readiness sweep.
# FLASH_LOAN_EXECUTOR_ADDRESS_ARBITRUM=
# FLASH_LOAN_EXECUTOR_ADDRESS_BASE=
# FLASH_LOAN_EXECUTOR_ADDRESS_OPTIMISM=
# FLASH_LOAN_EXECUTOR_ADDRESS_POLYGON=
# FLASH_LOAN_EXECUTOR_ADDRESS_UNICHAIN=
# FLASH_LOAN_EXECUTOR_ADDRESS_INK=
# CROSSCHAIN_EXECUTOR_ADDRESS_ARBITRUM=
# CROSSCHAIN_EXECUTOR_ADDRESS_POLYGON=

# Dashboard frontend (Vite build; reads this master file via `envDir`).
# Base URL the frontend uses to reach the backend; empty = same origin (the
# single-port launcher/.exe path). Only set for a split dev origin.
# VITE_API_URL=http://localhost:8787
# Optional WalletConnect project id (MetaMask via injected connector needs none).
# VITE_WALLETCONNECT_PROJECT_ID=


# ── Engine — Python detection core (prefix L2ARB__) ──────────────────────────
# In the wired topology the engine is fed pool state by the ingestion layer over
# HTTP (POST /detect), so it needs no RPC of its own. The vars below are for the
# engine's OPTIONAL standalone live mode and its detection tuning.

# Blockscout independent-verification oracle (data-integrity tier). The engine
# cross-checks RPC-derived pool state against Blockscout. You provide ONLY an API
# key — the per-chain explorer endpoints are built into the engine, so there is
# nothing else to configure. The key is optional (Blockscout's public API works
# without one, just rate-limited) and is a read-only rate-limit credential, never
# a signing/write secret. Get one at https://blockscout.com → API keys.
L2ARB__BLOCKSCOUT__API_KEY=

# Optional standalone RPC endpoints (one HTTPS + one WSS per chain; comma-separate
# a primary + backups for failover). Leave unset when running the wired stack.
# L2ARB__CHAINS__ARBITRUM__HTTP=https://arb1.example-rpc/v2/KEY
# L2ARB__CHAINS__ARBITRUM__WSS=wss://arb1.example-rpc/v2/KEY
# L2ARB__CHAINS__BASE__HTTP=https://base.example-rpc/v2/KEY
# L2ARB__CHAINS__BASE__WSS=wss://base.example-rpc/v2/KEY
# L2ARB__CHAINS__OPTIMISM__HTTP=https://opt.example-rpc/v2/KEY
# L2ARB__CHAINS__OPTIMISM__WSS=wss://opt.example-rpc/v2/KEY

# Detection tuning (safe defaults shown). Each of these is the operator-wide
# default the engine falls back to when a /detect request omits the
# equivalent field — an explicit value in the request always wins.
# L2ARB__MIN_PROFIT_BPS=5            # ignore opportunities below this net edge
# L2ARB__MAX_HOPS=4                  # bound for multi-hop cycle search
# L2ARB__MAX_LATENCY_MS_P99=250      # SLO: block-event -> opportunity emitted
# L2ARB__GAS_SAFETY_MULTIPLIER=1.5   # haircut applied to modelled gas
# L2ARB__MAX_POOL_AGE_SECONDS=120    # reject a cycle touching a pool older than this (data-integrity freshness gate)
# L2ARB__CROSS_CHAIN_PRICE_DRIFT_BPS_PER_MINUTE=2.0  # cross-chain only: settle-time-scaled price-drift haircut on the sell-leg proceeds (non-atomic settlement risk; docs/ARBITRAGE_THEORY.md §5)
# L2ARB__REDIS_URL=redis://localhost:6379/0
# L2ARB__LOG_LEVEL=INFO              # CRITICAL|ERROR|WARNING|INFO|DEBUG|NOTSET — wired to real structlog/logging setup
# L2ARB__METRICS_PORT=9090


# ── Ingestion — Rust l2-ingest (NO .env — TOML-configured) ───────────────────
# The ingestion binary is configured entirely by its TOML file, not env vars.
# Copy ingestion/config/config.example.toml and fill real RPC endpoints + pools,
# or let the launcher generate .l2arb/config.toml on first run (`l2arb setup`).
#
# RPC RATE-LIMIT FAILOVER: in that config, each chain's ws_url and http_url accept
# a COMMA-SEPARATED list — a primary plus backup endpoints, e.g.
#   http_url = "https://primary-rpc, https://backup-rpc"
# On a 429 or transport error the reads hand off to the next endpoint
# automatically. Reads are also Multicall3-batched to minimise request volume.


# ── Contracts — deployment tooling ONLY (human-gated; NOT read by the bot) ────
# ⚠  These are used only for the deliberate, human-authorised Hardhat deploy/
#    verify step against audited contracts. The running detection stack (engine,
#    ingestion, dashboard) never reads them and never broadcasts a transaction.
#    If you prefer to keep deploy secrets out of the shared file, leave PRIVATE_KEY
#    blank here and put it in a local `contracts/.env` instead (it overrides this).
#    Never commit a real key.
PRIVATE_KEY=
# Deploy/fork RPC endpoints (public fallbacks are used if unset).
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
INK_RPC_URL=https://rpc-gel.inkonchain.com
UNICHAIN_RPC_URL=https://mainnet.unichain.org
POLYGON_RPC_URL=https://polygon-rpc.com
# Mainnet-fork tests: point at an (ideally archival) RPC for the chain to fork
# (the included fork suite targets Arbitrum One). Optionally pin a block.
FORK_RPC_URL=https://arb1.arbitrum.io/rpc
FORK_BLOCK=
# Block-explorer API key for `hardhat verify` (Etherscan-family).
ETHERSCAN_API_KEY=


# ── Launcher ─────────────────────────────────────────────────────────────────
# Override where the app is installed / run from (default: repo root in a dev
# checkout, or a per-user dir for the frozen .exe).
# L2ARB_HOME=/abs/path/to/workspace
