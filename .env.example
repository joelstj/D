# ─────────────────────────────────────────────────────────────────────────────
# L2 Arbitrage Flash-Loan Bot — unified environment example.
# Copy to .env and edit. Every value has a safe default; nothing here is a secret
# (this system holds no private keys). Per-component detail lives in each
# component's own .env.example (engine/.env.example, dashboard/.env.example,
# contracts/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── Dashboard (Node backend + React UI) ──────────────────────────────────────
PORT=8787
# simulated = zero-config paper stream · external = real detections from the
# ingestion layer over WebSocket · live = dashboard's own on-chain quoting (WIP)
DATA_SOURCE=simulated
# Where the dashboard reads real detections when DATA_SOURCE=external:
INGEST_FEED_URL=ws://127.0.0.1:9001
# paper = simulate fills (safe default) · live = gated real execution (disabled)
EXECUTION_MODE=paper
CORS_ORIGIN=http://localhost:8080
# Set by the launcher to serve the built UI on the same origin as the API.
# SERVE_STATIC_DIR=/abs/path/to/dashboard/frontend/dist

# Optional RPCs for the dashboard's own (WIP) live provider — not needed for the
# external feed, which gets its data from the ingestion layer.
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL_POLYGON=

# ── Engine (Python detection core) ───────────────────────────────────────────
# The engine is fed pool state by the ingestion layer over HTTP (POST /detect),
# so it needs no RPC of its own in the wired topology. For its optional
# standalone live mode, see engine/.env.example (vars are prefixed L2ARB__).

# ── Ingestion (Rust l2-ingest) ───────────────────────────────────────────────
# The ingestion binary is configured entirely by its TOML file, NOT env vars.
# Copy ingestion/config/config.example.toml and fill real RPC endpoints + pools.
# The launcher generates one at .l2arb/config.toml on first run.
#
# RPC RATE-LIMIT FAILOVER: in that config, each chain's ws_url and http_url accept
# a COMMA-SEPARATED list — a primary plus backup endpoints, e.g.
#   http_url = "https://primary-rpc, https://backup-rpc"
# On a rate-limit (429) or transport error the reads hand off to the next endpoint
# automatically. Reads are also Multicall3-batched to minimise request volume.

# ── Launcher ─────────────────────────────────────────────────────────────────
# Override where the app is installed / run from (default: repo root in a dev
# checkout, or a per-user dir for the frozen .exe).
# L2ARB_HOME=/abs/path/to/workspace
