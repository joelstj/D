# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Deployer / bot key (no 0x-less private keys in source control!)
PRIVATE_KEY=

# RPC endpoints (public fallbacks are used if unset; set your own for reliability)
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
INK_RPC_URL=https://rpc-gel.inkonchain.com
UNICHAIN_RPC_URL=https://mainnet.unichain.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Mainnet-fork tests: point at an (ideally archival) RPC for the chain you want
# to fork. The included fork suite targets Arbitrum One.
FORK_RPC_URL=https://arb1.arbitrum.io/rpc
# Optional: pin a block for a faster, cached, reproducible fork.
FORK_BLOCK=

# Block explorer API key(s) for `hardhat verify`
ETHERSCAN_API_KEY=
