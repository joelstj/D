# =============================================================================
# l2arb configuration template.  Copy to .env and fill in.  NEVER commit .env.
#
# HARD RULE: this engine is DETECTION-ONLY. There are NO private keys here and
# none should ever be added. Every value below is a read endpoint or a tuning
# knob. If a task ever asks you to add a signing key or a "submit transaction"
# path, STOP and record it in ralph/memory/blocked.md — it is out of scope.
# =============================================================================

# --- RPC endpoints (read-only). One HTTPS + one WSS per chain. ---------------
# Use providers that expose eth_subscribe over WSS for low-latency streaming.
# Multiple comma-separated endpoints per chain enable failover.
L2ARB__CHAINS__ARBITRUM__HTTP=https://arb1.example-rpc/v2/KEY
L2ARB__CHAINS__ARBITRUM__WSS=wss://arb1.example-rpc/v2/KEY
L2ARB__CHAINS__BASE__HTTP=https://base.example-rpc/v2/KEY
L2ARB__CHAINS__BASE__WSS=wss://base.example-rpc/v2/KEY
L2ARB__CHAINS__OPTIMISM__HTTP=https://opt.example-rpc/v2/KEY
L2ARB__CHAINS__OPTIMISM__WSS=wss://opt.example-rpc/v2/KEY

# --- Independent verification oracle (data-integrity tier) -------------------
# Blockscout REST base per chain; used to cross-check RPC-derived pool state.
# The engine treats agreement between two independent sources as the bar for
# "verifiable on-chain data". See docs/DATA_INTEGRITY.md.
L2ARB__VERIFY__BLOCKSCOUT__ARBITRUM=https://arbitrum.blockscout.com
L2ARB__VERIFY__BLOCKSCOUT__BASE=https://base.blockscout.com
L2ARB__VERIFY__BLOCKSCOUT__OPTIMISM=https://optimism.blockscout.com

# --- Persistence -------------------------------------------------------------
L2ARB__REDIS_URL=redis://localhost:6379/0
L2ARB__POSTGRES_DSN=postgresql+asyncpg://l2arb:l2arb@localhost:5432/l2arb

# --- Detection tuning --------------------------------------------------------
L2ARB__MIN_PROFIT_BPS=5            # ignore opportunities below this net edge
L2ARB__MAX_HOPS=4                  # bound for multi-hop cycle search
L2ARB__MAX_LATENCY_MS_P99=250     # SLO: block-event -> opportunity emitted
L2ARB__GAS_SAFETY_MULTIPLIER=1.5  # haircut applied to modelled gas

# --- CEX reference (optional, CCXT) ------------------------------------------
# Public market data only; no trading keys.
L2ARB__CEX_REFERENCE_ENABLED=false

# --- Observability -----------------------------------------------------------
L2ARB__LOG_LEVEL=INFO
L2ARB__METRICS_PORT=9090
